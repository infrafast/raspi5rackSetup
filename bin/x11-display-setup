#!/usr/bin/env bash
set -euo pipefail

: "${SCREEN_RESOLUTION:?SCREEN_RESOLUTION is not defined}"

case "$SCREEN_RESOLUTION" in
    "1024x768")
        /usr/bin/xrandr --output HDMI-1 --mode 1024x768
        ;;
    "1368x768")
        /usr/bin/xrandr --newmode "1368x768_60.00" 85.25 1368 1440 1576 1784 768 771 781 798 -hsync +vsync 2>/dev/null || true
        /usr/bin/xrandr --addmode HDMI-1 "1368x768_60.00" 2>/dev/null || true
        /usr/bin/xrandr --output HDMI-1 --mode "1368x768_60.00"
        ;;
    *)
        echo "ERROR: Unsupported SCREEN_RESOLUTION: $SCREEN_RESOLUTION" >&2
        exit 1
        ;;
esac
