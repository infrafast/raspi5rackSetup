[Unit]
Description=X11 VNC server
After=x11-display-setup.service
Requires=x11-display-setup.service

[Service]
Type=simple
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/usr/bin/x11vnc -display :0 -auth /home/pi/.Xauthority -rfbauth /home/pi/.vnc/passwd -forever -shared -listen 0.0.0.0 -xkb
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
